---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import StorefrontSection from "@/features/storefront/StorefrontSection.astro";
import { MOCK_PRODUCTS } from "@/data/demo-catalog";

export const prerender = true;

export function getStaticPaths() {
    return MOCK_PRODUCTS.map((product) => ({ params: { slug: product.handle }, props: { title: product.title, description: product.description } }));
}

const { title, description } = Astro.props;
---
<StorefrontLayout title={title} description={description}>
    <StorefrontSection view="product" />
</StorefrontLayout>
