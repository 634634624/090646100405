---
import StorefrontLayout from "@/layouts/StorefrontLayout.astro";
import { Button } from "@/components/base/buttons/button";
import { ArrowRight } from "@untitledui-pro/icons/line";
---
<StorefrontLayout title="Az oldal nem található" description="A kért oldal nem található.">
    <main class="mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-center justify-center px-4 py-16 text-center">
        <p class="text-sm font-semibold text-brand-secondary">404</p>
        <h1 class="mt-3 text-balance text-display-md font-semibold text-primary">Ez az oldal nincs itt.</h1>
        <p class="mt-4 text-lg text-secondary">A hivatkozás régi lehet, vagy az oldal még nem készült el.</p>
        <Button href="/" client:load className="mt-8" iconTrailing={ArrowRight}>Vissza a főoldalra</Button>
    </main>
</StorefrontLayout>
