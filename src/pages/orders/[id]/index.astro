---
import "@/styles/global.css";
import Section1 from "@/toolkit/commerce-shopify/components/SmallShopSection.astro";
export function getStaticPaths() { return [{"params":{"id":"demo-1001"}}]; }
---
<!doctype html>
<html lang="hu-HU" data-theme="kit" data-uui-client-state="prelaunch">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Confirm and communicate fulfillment state." /><meta name="robots" content="noindex,nofollow" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>Confirm and communicate fulfillment state.</title><script is:inline>try{if(localStorage.getItem("uui-site-theme")==="dark")document.documentElement.classList.add("dark-mode")}catch{}</script></head>
  <body class="bg-primary text-primary">
    <main>
        <Section1 {...{"brand":"Fieldwork Living","view":"order"}} />
    </main>
  </body>
</html>
