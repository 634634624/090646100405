{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "090646100405",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "WEBSHIPPY_WRITE_MODE": "test"
  }
}
