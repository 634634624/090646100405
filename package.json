{
  "name": "uui-client-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "quality:lint": "node scripts/client-quality.mjs",
    "browser:stale:check": "node scripts/headless-browser-guard.mjs check",
    "browser:stale:cleanup": "node scripts/headless-browser-guard.mjs cleanup --max-age-seconds 0",
    "browser:screenshot": "node scripts/run-headless-chrome.mjs",
    "prequality:e2e": "node scripts/headless-browser-guard.mjs cleanup --max-age-seconds 0",
    "quality:e2e": "node scripts/web-build-qa.mjs",
    "postquality:e2e": "node scripts/headless-browser-guard.mjs cleanup --max-age-seconds 0",
    "quality:closeout": "npm run check && npm test && npm run build && npm run quality:lint && npm run quality:e2e"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/react": "^5.0.0",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@react-types/shared": "^3.33.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.22",
    "astro": "^7.1.3",
    "react": "^19.0.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "^5.0.0",
    "@untitledui-pro/icons": "file:vendor/untitledui-pro-icons"
  },
  "engines": {
    "node": "22.x"
  }
}
